{
  "presets": [
    "@babel/preset-typescript",
    "@babel/preset-env",
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ],

    [
      "@babel/plugin-transform-react-jsx",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "plugins": [["@babel/transform-runtime"]]
}
